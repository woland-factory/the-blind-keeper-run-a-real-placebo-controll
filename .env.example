# Copy to .env and fill in. Never commit .env.
NODE_ENV=development

# HTTP port the server listens on.
PORT=8080

# Postgres connection string.
DATABASE_URL=postgres://blindkeeper:change-me@localhost:5432/blindkeeper

# Public base URL used to build magic links.
APP_BASE_URL=http://localhost:8080

# Signs the session cookie. Use a random string of at least 32 characters.
SESSION_COOKIE_SECRET=change-me-to-a-random-string-min-32-chars

# Mail transport: "central" (production) or "console" (dev/test).
MAIL_TRANSPORT=console

# Required only when MAIL_TRANSPORT=central. Header for the central mailer.
INTERNAL_SERVICE_KEY=

# Central mailer base URL.
MAILER_URL=http://central-mailer-prod-api:8000

# Backend error tracking. Disabled if unset.
SENTRY_DSN=

# When true, load the demo account on startup. Off by default.
SEED_DEMO=false

# Global requests per minute per IP.
RATE_LIMIT_MAX=100

# Auth requests per minute per IP.
AUTH_RATE_LIMIT_MAX=5

# Mutations per minute per IP (locking a design).
MUTATION_RATE_LIMIT_MAX=20

# Frontend build-time vars (Vite). All optional.
VITE_SENTRY_DSN=
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_URL=
